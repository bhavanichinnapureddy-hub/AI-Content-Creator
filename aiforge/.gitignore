# Environment files — NEVER commit these
.env
.env.local
.env.production
.env.staging
.env.development.local
.env.test.local
.env.production.local
*.env
**/.env

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/

# TypeScript compiled output
*.js.map
*.d.ts.map

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output/

# Vite / Rollup cache
.vite/
.rollup.cache/

# Prisma generated (keep schema, ignore migrations if desired, but keep migrations)
# backend/prisma/generated/

# OS files
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# IDE / Editor
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Uploads (private user files should never be in git)
backend/uploads/
backend/private/

# Secrets / Keys (extra safety)
*.pem
*.key
*.cert
*.pfx
*.p12
id_rsa
id_rsa.*
*.secret

# Temp files
*.tmp
*.temp
.cache/

# Package manager lock files (keep one, ignore others)
# yarn.lock
# pnpm-lock.yaml
