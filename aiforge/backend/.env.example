# =============================================
# AIForge Backend Environment Variables
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/aiforge_db?schema=public

# --- JWT ---
# Generate strong secrets: openssl rand -base64 64
JWT_ACCESS_SECRET=your_super_strong_access_secret_at_least_64_chars_long_replace_this
JWT_REFRESH_SECRET=your_super_strong_refresh_secret_at_least_64_chars_long_replace_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS / Client ---
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Password Reset ---
# Pepper adds extra security on top of argon2 hashing
PASSWORD_RESET_EXPIRES_IN=3600000

# --- File Upload ---
# Max file size in bytes (10MB)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# --- AI Provider (optional — for AI Brief Builder) ---
# Only required if AI features are enabled
# AI_PROVIDER_API_KEY=your_ai_provider_api_key_here
# AI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Cloudinary (optional — for file storage) ---
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# --- Email (optional — for password reset emails) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@aiforge.com
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=AIForge <no-reply@aiforge.com>

# --- Admin Seed ---
# Used only by the seed script to create the initial admin account
ADMIN_EMAIL=admin@aiforge.demo
ADMIN_PASSWORD=AIForge@Admin2024!
ADMIN_NAME=AIForge Admin
